{
  "name": "adaptive-web",
  "private": true,
  "version": "1.0.0",
  "description": "Adaptive Web — signal-adaptive delivery that adapts to each user's real network and device",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host",
    "start": "npm run build && npm run preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "server:dev": "node --watch server/index.js",
    "server:start": "node server/index.js",
    "server:seed": "node server/seed.js"
  },
  "dependencies": {
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "mongoose": "^8.24.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@rollup/wasm-node": "^4.63.4",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "supertest": "^7.3.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
