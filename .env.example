# TraceGuard AI - Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# NEVER commit actual secrets or API keys.

# Application Settings
APP_NAME=TraceGuard AI
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
HOST=127.0.0.1
PORT=8000

# CORS Whitelist (JSON array or comma-separated)
CORS_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501","http://localhost:3000","http://localhost:8000"]

# Security & Upload Constraints
MAX_UPLOAD_SIZE_BYTES=5242880
ALLOWED_EXTENSIONS=[".txt",".pdf",".eml",".json",".csv",".md"]

# Directory Paths
UPLOAD_DIR=outputs/uploads
AUDIT_LOG_DIR=outputs/audit_logs

# Logging
LOG_LEVEL=INFO
