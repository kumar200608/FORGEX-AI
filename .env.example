# ExplainX Environment Variables Configuration Template
# Copy this file to .env and configure your keys

# AI Inference Keys (At least one required)
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=

# Server Configuration
PORT=8000
JWT_SECRET=explainx_super_secure_jwt_secret_change_me_2026

# Optional: MongoDB URI (Falls back to resilient local JSON store if empty)
MONGO_URI=mongodb://localhost:27017/
