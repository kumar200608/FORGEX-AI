# Backend configuration for `server/` (Express + Mongoose).
#
# Copy this file to `.env` and fill in a real URI:
#     cp .env.example .env
#
# `.env` is gitignored — never commit real credentials.

# Required. MongoDB connection string. Two supported options:
#   1. Atlas (free tier is enough):
#        mongodb+srv://<user>:<password>@<cluster>.mongodb.net/adaptive?retryWrites=true&w=majority
#   2. Local MongoDB Community:
#        mongodb://127.0.0.1:27017/adaptive
# If this is missing or unreachable the server and the seed script exit non-zero.
MONGODB_URI=mongodb://127.0.0.1:27017/adaptive

# Optional. Port the API listens on. Defaults to 4000.
PORT=4000
