# Dependencies — restored by `npm install`, never part of the deliverable.
node_modules/

# Build output — regenerated by `npm run build`.
dist/

# Local environment / secrets — may hold machine-specific values.
.env
.env.*

# ...but the documented template is meant to be committed. Without this negate,
# the `.env.*` rule above would swallow it.
!.env.example

# Logs.
*.log
npm-debug.log*

# Editor + OS junk.
.idea/
.vscode/
.DS_Store
Thumbs.db
